<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Fullscreen Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Status Overlay Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#CC1E1E1E"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PhoCast Streamer"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_idle"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="IDLE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#22FFFFFF" />

            <!-- Wi-Fi IP Info -->
            <TextView
                android:id="@+id/tvWifiInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi: 192.168.1.50:5000"
                android:textColor="#B0BEC5"
                android:textSize="14sp" />

            <!-- USB Mode Info -->
            <TextView
                android:id="@+id/tvUsbInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="USB: adb forward tcp:5000 tcp:5000"
                android:textColor="#78909C"
                android:textSize="12sp" />

            <!-- Active Clients -->
            <TextView
                android:id="@+id/tvClientCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Connected Clients: 0"
                android:textColor="#81C784"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#22FFFFFF" />

            <!-- Resolution & FPS Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Res: "
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip480p"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="480p"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip720p"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:checked="true"
                        android:text="720p"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip1080p"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="1080p"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </com.google.android.material.chip.ChipGroup>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip30Fps"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:checked="true"
                        android:text="30 FPS"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip60Fps"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="60 FPS"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Torch Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnTorch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:contentDescription="Torch"
            app:backgroundTint="#333333"
            app:tint="#FFFFFF"
            app:srcCompat="@android:drawable/ic_menu_agenda" />

        <!-- Screen Off / Keep Cool Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnDimScreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:contentDescription="Screen Off (Keep Cool)"
            app:backgroundTint="#333333"
            app:tint="#00E676"
            app:srcCompat="@android:drawable/ic_lock_power_off" />

        <!-- Main Stream Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleStream"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="START STREAM"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:backgroundTint="#00E676"
            android:textColor="#000000" />

        <!-- Switch Camera Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:contentDescription="Switch Camera"
            app:backgroundTint="#333333"
            app:tint="#FFFFFF"
            app:srcCompat="@android:drawable/ic_menu_rotate" />
    </LinearLayout>

    <!-- Fullscreen Dim Overlay (AMOLED Screen Off / Anti-Heat Mode) -->
    <FrameLayout
        android:id="@+id/layoutDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PhoCast Streaming Active"
                android:textColor="#55FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Screen &amp; Preview turned OFF to keep phone cool."
                android:textColor="#33FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="[ Tap anywhere to wake screen ]"
                android:textColor="#4400E676"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
