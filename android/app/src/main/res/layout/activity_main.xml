<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Fullscreen Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Status Overlay Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#CC1E1E1E"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PhoCast Streamer"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_idle"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="IDLE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#22FFFFFF" />

            <!-- Wi-Fi IP Info -->
            <TextView
                android:id="@+id/tvWifiInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi: 192.168.1.50:5000"
                android:textColor="#B0BEC5"
                android:textSize="14sp" />

            <!-- USB Mode Info -->
            <TextView
                android:id="@+id/tvUsbInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="USB: adb forward tcp:5000 tcp:5000"
                android:textColor="#78909C"
                android:textSize="12sp" />

            <!-- Active Clients -->
            <TextView
                android:id="@+id/tvClientCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Connected Clients: 0"
                android:textColor="#81C784"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Torch Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnTorch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:contentDescription="Torch"
            app:backgroundTint="#333333"
            app:tint="#FFFFFF"
            app:srcCompat="@android:drawable/ic_menu_agenda" />

        <!-- Main Stream Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleStream"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="START STREAM"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:backgroundTint="#00E676"
            android:textColor="#000000" />

        <!-- Switch Camera Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:contentDescription="Switch Camera"
            app:backgroundTint="#333333"
            app:tint="#FFFFFF"
            app:srcCompat="@android:drawable/ic_menu_rotate" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
